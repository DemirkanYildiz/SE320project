#hud-container {
    width: 100%;
    height: 100%;
    padding: 20px;
    justify-content: flex-start;
    align-items: flex-start;
}

#health-bar {
    width: 300px;
    height: 30px;
}

#health-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 5px;
    border-width: 0px;
}

#health-bar .unity-progress-bar__progress {
    background-color: rgb(220, 40, 40);
    border-radius: 5px;
    margin: 2px;
}