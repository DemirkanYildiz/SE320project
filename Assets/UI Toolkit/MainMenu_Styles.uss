/* Ana Kapsayýcý: Sadece ortalama yapýyor ve dýþý siyah */
.main-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: black;
}

/* --- PANEL TANIMLAMALARI (NÝHAÝ DURUM) --- */

/* Ana Menü Paneli: GÖRÜNÜR (Nihai Baþlangýç Durumu) */
#main-menu-panel {
    display: flex; /* GÖRÜNÜR */
    
    width: 500px;
    height: auto;
    border-radius: 15px;
    padding: 20px;
    align-items: center;
    background-image: url('project:/Assets/Ui/Backgrounds/MainMenuBackgroundPhoto.png'); 
    background-size: cover;
    background-position: center;
}

/* Seçenekler Paneli: GÝZLÝ (Stilleri ve hizalamasý dahil) */
#options-panel {
    display: none; /* GÝZLÝ */

    width: 500px;
    height: 350px; /* Yüksekliði biraz arttýrdým */
    padding: 20px;
    border-radius: 15px;
    background-image: url('project:/Assets/Ui/Backgrounds/MainMenuBackgroundPhoto.png'); 
    background-size: cover;
    background-position: center;
    flex-direction: column;
    justify-content: space-between; 
}

/* Zindan Seçim Paneli: GÝZLÝ (Stilleri ve hizalamasý dahil) */
#dungeon-select-panel {
    display: none; /* GÝZLÝ */

    width: 600px;
    height: 400px;
    padding: 20px;
    border-radius: 15px;
    background-image: url('project:/Assets/Ui/Backgrounds/MainMenuBackgroundPhoto.png'); 
    background-size: cover;
    background-position: center;
    flex-direction: column;
    justify-content: space-between; 
}


/* --- ANA MENÜ ELEMANLARI --- */
#title-label {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}
#play-button, #options-button, #exit-button {
    width: 250px;
    height: 50px;
    font-size: 20px;
    color: white;
    background-color: rgba(30, 30, 30, 0.7);
    border-color: rgba(255, 255, 255, 0.5);
    border-width: 1px;
    border-radius: 10px;
    margin-top: 10px;
}
#play-button:hover, #options-button:hover, #exit-button:hover {
    background-color: rgba(80, 80, 80, 0.8);
    border-color: white;
}


/* --- ZÝNDAN SEÇÝM PANELÝ ELEMANLARI --- */
#dungeon-content-container {
    display: flex;
    flex-direction: row; 
    flex-grow: 1; 
    width: 100%;
}
#dungeon-list {
    flex-grow: 1;
    flex-basis: 40%; 
    border-right-width: 2px;
    border-right-color: rgb(150, 150, 150);
    padding: 10px;
}
#stats-display {
    flex-grow: 1;
    flex-basis: 60%; 
    padding: 15px;
}
#stats-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 15px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}
#stats-hp, #stats-armor, #stats-damage, #stats-cooldown {
    font-size: 18px;
    color: rgb(200, 200, 200);
    margin-top: 8px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
#dungeon-1-button, #dungeon-2-button {
    width: 100%; 
    height: 45px;
    margin-bottom: 10px;
    font-size: 18px;
    color: white;
    background-color: rgba(30, 30, 30, 0.7);
    border-color: rgba(255, 255, 255, 0.5);
    border-width: 1px;
    border-radius: 10px;
}
#dungeon-1-button:hover, #dungeon-2-button:hover {
    background-color: rgba(80, 80, 80, 0.8);
    border-color: white;
}
.button-selected {
    background-color: rgba(100, 150, 255, 0.8); 
    border-color: white;
}
#dungeon-bottom-bar {
    display: flex;
    flex-direction: row; 
    justify-content: space-between; 
    border-top-width: 2px;
    border-top-color: rgb(150, 150, 150);
    padding-top: 10px; 
    height: 50px; 
    width: 100%; 
}
#dungeon-back-button, #dungeon-enter-button {
    width: 150px;
    height: 100%; 
    color: white;
    background-color: rgba(30, 30, 30, 0.7);
    border-color: rgba(255, 255, 255, 0.5);
    border-width: 1px;
    border-radius: 10px;
}
#dungeon-back-button:hover, #dungeon-enter-button:hover {
    background-color: rgba(80, 80, 80, 0.8);
    border-color: white;
}


/* --- SEÇENEKLER PANELÝ ELEMANLARI (BU KISIM EKSÝKTÝ) --- */

#options-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 15px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}
#options-content-container {
    display: flex;
    flex-direction: row; 
    flex-grow: 1; 
    width: 100%;
}
#controls-box {
    flex-grow: 1;
    flex-basis: 50%; 
    border-right-width: 2px;
    border-right-color: rgb(150, 150, 150);
    padding: 10px;
}
#description-box {
    flex-grow: 1;
    flex-basis: 50%; 
    padding: 10px;
}
#controls-label, #description-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 10px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
#options-back-button {
    width: 150px;
    height: 50px;
    align-self: center; 
    margin-top: 15px; 
    color: white;
    background-color: rgba(30, 30, 30, 0.7);
    border-color: rgba(255, 255, 255, 0.5);
    border-width: 1px;
    border-radius: 10px;
}
#options-back-button:hover {
    background-color: rgba(80, 80, 80, 0.8);
    border-color: white;
}